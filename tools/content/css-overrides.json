  "patch": {
    "css-list-kurzschreibweise": {
      "explanation": "Gültig sind square inside, none und inside square. Die Werte der Kurzschreibweise stehen in beliebiger Reihenfolge und werden durch Leerzeichen getrennt – ein Komma macht die Deklaration ungültig."
    },
    "css-box-border-box": {
      "prompt": "Wie breit ist der Inhaltsbereich?"
    },
    "css-box-drei-karten-ohne-border-box": {
      "prompt": "Drei Karten sollen nebeneinander stehen, dazwischen insgesamt 2rem Abstand. Ohne `* { box-sizing: border-box; }` rutscht die dritte Karte in die nächste Zeile. Warum?",
      "explanation": "Bei content-box kommt der Rahmen zur Breite hinzu: Jede Karte ist width + 2px breit. Drei Karten plus 2rem Abstand ergeben mehr als 100 % – die dritte Karte bricht um."
    },
    "css-box-negativer-margin": {
      "replaceOption": {
        "D": "Das Element wird 10px niedriger"
      }
    },
    "css-box-clear": {
      "replaceOption": {
        "D": "position: relative;"
      }
    },
    "css-flex-alle-gleich-hoch": {
      "replaceOption": {
        "D": "Flex-Items erben die Höhe des Containers automatisch über height: inherit"
      }
    },
    "css-flex-zu-viele-items": {
      "replaceOption": {
        "D": "Die Items behalten 200px und ragen rechts aus dem Container heraus"
      }
    },
    "css-flex-querachse": {
      "explanation": "Merkhilfe: Justify wirkt auf der Hauptachse, Align auf der Querachse."
    },
    "css-pos-anchor-positioning": {
      "replaceOption": {
        "D": "Ein Element beim Scrollen am oberen Rand festhalten"
      },
      "explanation": "anchor-name markiert ein Bezugselement, position-anchor und anchor() beziehen sich darauf – unabhängig vom eigenen Containing Block. Ersetzt zunehmend JavaScript-Bibliotheken wie Floating UI oder Popper.js; Baseline Newly available seit Januar 2026. Am oberen Rand festhalten wäre position: sticky."
    },
    "css-pos-falsche-ecke": {
      "explanation": "position: relative an .parent. absolute richtet sich am nächsten positionierten Vorfahren aus – gibt es keinen, am Anfangs-Containing-Block (der Seite). Ein typischer Debugging-Fall: Das Element „springt“ an eine falsche Stelle."
    },
    "css-pos-z-index-9999": {
      "explanation": ".a bildet mit position: relative und z-index: 1 einen eigenen Stacking Context. z-index: 9999 gilt nur INNERHALB von .a; nach außen zählt die 1 von .a – und die ist kleiner als die 2 von .b. Eine der häufigsten Fehlerquellen bei z-index."
    },
    "css-rev-verschachtelte-kombination": {
      "answer": "Diese Aufgabe kombiniert Nachfahren-Kombinator, :not(), :nth-child(), die dynamische Pseudo-Klasse :hover und das Pseudo-Element ::first-line (hier mit einfachem Doppelpunkt geschrieben – für die CSS2-Pseudo-Elemente aus Kompatibilitätsgründen weiterhin gültig).\n\nLöse den Selektor von links nach rechts auf: section:not(:last-of-type) grenzt die betroffenen Sections ein, article:nth-child(2) wählt darin das zweite Kind-Element, :hover macht es interaktiv, p:first-line beschränkt die Wirkung auf die erste Zeile jedes p darin."
    },
    "css-pos-sticky": {
      "explanation": "sticky verhält sich zunächst wie relative und ab einem Schwellenwert aus top, bottom, left oder right wie fixed; overflow: hidden auf einem Vorfahren verhindert das Kleben. Falsch sind die anderen beiden Aussagen: sticky wirkt nur innerhalb der Höhe des Elternelements, und z-index ist dafür nicht nötig."
    },
    "css-sel-komma-oder-kein-komma": {
      "explanation": "Ohne Trennzeichen müssen alle Teile auf dasselbe Element zutreffen (UND); Spezifität 0-2-1. „Alle div, alle .note und alle .highlight“ wäre der Selektor div, .note, .highlight (Komma = ODER)."
    },
    "css-rev-attribut-selektor-exakter-wert": {
      "answer": "[type=\"email\"] verlangt exakte Gleichheit des Attributwerts – ein anderer type-Wert erfüllt die Bedingung nicht. Für Teilstrings gibt es ^= (beginnt mit), $= (endet mit) und *= (enthält)."
    }
  },
